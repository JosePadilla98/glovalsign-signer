# URL del backend de Glovalsign al que el dev server redirige las peticiones /api
# En producción el proxy no existe: el servidor web (nginx, etc.) debe hacer el proxy hacia el backend.
BACKEND_URL=http://localhost:4000

# Tamaño del placeholder de firma PKCS#7 en bytes (debe ser suficientemente grande para la cadena de certificados).
# Aumentar si aparece "Signature exceeds placeholder length". Por defecto: 32768 (32 KB).
# PUBLIC_SIGNATURE_LENGTH=32768
