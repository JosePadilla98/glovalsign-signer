# Copia este fichero a .env y rellena los valores reales.
# .env nunca se commitea a git.

# URL del backend de Glovalsign al que el dev server redirige las peticiones /api
BACKEND_URL=http://localhost:4000

# URL base del servidor de servlets de AutoFirma (solo necesaria para firma desde móvil).
# Debe ser el ORIGEN del servidor sin barra al final, e.g.:
#   PUBLIC_SERVLET_BASE_URL=https://firmas.mi-empresa.com
# En desarrollo, usar la URL de ngrok (cambia en cada sesión con el plan gratuito).
# Si se deja vacío, la app funciona en escritorio pero bloquea el acceso desde móviles.
PUBLIC_SERVLET_BASE_URL=

# Activa la firma trifásica en modo móvil. Cuando es true, AutoFirma App solo firma el hash
# del documento (más rápido con PDFs grandes) y el servidor se encarga de las fases PRE/POST.
# Requiere el WAR afirma-server-triphase-signer desplegado en Tomcat (además de los otros 2).
# false = firma simple: el PDF completo viaja al dispositivo. Más sencillo, más lento con PDFs grandes.
PUBLIC_TRIPHASE_SIGNING=false

# URL del servidor Tomcat con los WARs del servidor intermedio de AutoFirma.
# Solo se usa en el dev server para proxificar las rutas /afirma-signature-* y /afirma-server-triphase-signer.
# Prerequisito: ejecutar ./servlet/build.sh y luego cd servlet && docker compose up -d
# No tiene efecto en producción (el servidor web gestiona el proxy).
AUTOFIRMA_SERVICES_TARGET=http://localhost:8081

# Activa la consola flotante de depuración de firma (solo visible en modo dev).
# false por defecto — actívala solo cuando necesites diagnosticar tiempos.
PUBLIC_DEV_SIGNING_LOG=false
# Solo se usa en el dev server para proxificar las rutas /afirma-signature-* y /afirma-server-triphase-signer.
# Prerequisito: ejecutar ./servlet/build.sh y luego cd servlet && docker compose up -d
# No tiene efecto en producción (el servidor web gestiona el proxy).
AUTOFIRMA_SERVICES_TARGET=http://localhost:8081
